# Banco de dados (SQLite em arquivo no próprio VPS)
DATABASE_URL="file:./portal.db"
# Segredo para assinar o login da designer. Gere com: openssl rand -hex 32
SESSION_SECRET="troque-por-um-segredo-longo"
# Pasta onde ficam os arquivos enviados (moodboard, proposta, entrega)
UPLOAD_DIR="./uploads"
# Endereço público do portal, usado para montar o link da cliente
PUBLIC_URL="https://portal.estudiopetricor.com.br"
# Avisos por e-mail (opcional). Com Google Workspace: smtp.gmail.com, porta 465,
# o e-mail que envia e uma "senha de app" do Google (não a senha normal).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Petricor Estúdio <contato@estudiopetricor.com.br>"
